<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Crear Post</title>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
</head>
<body class="grey lighten-4">

  <nav class="blue darken-2">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">Social Media</a>
    </div>
  </nav>

  <main class="container" style="margin-top: 40px;">
    <h4 class="blue-text text-darken-2 center-align">Crear nuevo Post</h4>

    <div class="row">
      <form action="/posts" method="POST" class="col s12 card-panel">
        
        <div class="input-field">
          <select name="userId" required>
            <option value="" disabled selected>Selecciona un usuario</option>
            <% users.forEach(u => { %>
              <option value="<%= u._id %>"><%= u.name %> <%= u.lastName %></option>
            <% }) %>
          </select>
          <label>Usuario</label>
        </div>

        <div class="input-field">
          <input type="text" name="title" id="title" minlength="5" maxlength="30" required>
          <label for="title">Título (5–30)</label>
        </div>

        <div class="input-field">
          <textarea name="content" id="content" class="materialize-textarea" minlength="10" required></textarea>
          <label for="content">Contenido (≥10)</label>
        </div>

        <div class="input-field">
          <input type="text" name="hashtags" id="hashtags" placeholder="node,web">
          <label for="hashtags">Hashtags (separados por coma)</label>
        </div>

        <div class="input-field">
          <input type="url" name="imageUrl" id="imageUrl" placeholder="https://...">
          <label for="imageUrl">URL de imagen</label>
        </div>

        <div class="center-align" style="margin-top: 20px;">
          <button type="submit" class="btn waves-effect waves-light blue darken-2">
            <i class="material-icons left">add</i> Crear
          </button>
          <a href="/posts" class="btn grey">
            Volver al listado
          </a>
        </div>
      </form>
    </div>
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var elems = document.querySelectorAll('select');
      M.FormSelect.init(elems);
    });
  </script>
</body>
</html>
