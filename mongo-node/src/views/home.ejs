    <div class="row" style="margin-top: 50px;">
      <div class="col s12 m6">
        <a href="/posts" class="btn-large waves-effect waves-light blue darken-2">
          <i class="material-icons left">list</i> Ver Posts
        </a>
      </div>
      <div class="col s12 m6">
        <a href="/posts/create" class="btn-large waves-effect waves-light teal">
