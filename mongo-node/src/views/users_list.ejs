<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Usuarios - Social Media</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">Social Media</a>
            <div class="navbar-nav">
                <a class="nav-link" href="/users/create">Registrar Usuario</a>
                <a class="nav-link" href="/posts">Ver Posts</a>
                <a class="nav-link" href="/posts/create">Crear Post</a>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2><i class="bi bi-people"></i> Lista de Usuarios</h2>
                    <a href="/users/create" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Registrar Nuevo Usuario
                    </a>
                </div>

                <% if (users && users.length > 0) { %>
                    <div class="row">
                        <% users.forEach(function(user) { %>
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h5 class="card-title mb-0">
                                            <i class="bi bi-person-circle text-primary"></i>
                                            <%= user.name %> <%= user.lastName %>
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text">
                                            <i class="bi bi-envelope text-muted"></i>
                                            <strong>Email:</strong> <%= user.email %>
                                        </p>
                                        <p class="card-text">
                                            <i class="bi bi-calendar-event text-muted"></i>
                                            <strong>Edad:</strong> <%= user.age %> años
                                        </p>
                                        <% if (user.phoneNumber) { %>
                                            <p class="card-text">
                                                <i class="bi bi-telephone text-muted"></i>
                                                <strong>Teléfono:</strong> <%= user.phoneNumber %>
                                            </p>
                                        <% } %>
                                        <p class="card-text">
                                            <small class="text-muted">
                                                <i class="bi bi-clock"></i>
                                                Registrado: <%= new Date(user.createdAt).toLocaleDateString('es-ES') %>
                                            </small>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-person-x display-1 text-muted"></i>
                        <h4 class="mt-3 text-muted">No hay usuarios registrados</h4>
                        <p class="text-muted">¡Sé el primero en registrarte!</p>
                        <a href="/users/create" class="btn btn-primary">
                            <i class="bi bi-person-plus"></i> Registrar Primer Usuario
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>